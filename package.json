{
  "name": "logman",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "logman - Internship Log Book generator. A local web app to write, edit, and export daily internship activities to a print-ready PDF.",
  "author": {
    "name": "Khip01",
    "url": "https://github.com/Khip01"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khip01/logman.git"
  },
  "homepage": "https://github.com/Khip01/logman#readme",
  "bugs": {
    "url": "https://github.com/Khip01/logman/issues"
  },
  "keywords": [
    "logbook",
    "internship",
    "magang",
    "pdf",
    "vite",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"pnpm:dev:web\" \"pnpm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:domain": "vitest run src/lib/domain",
    "test:server": "vitest run server",
    "test:e2e:export": "playwright test e2e/export.spec.ts",
    "test:e2e:editor": "playwright test e2e/editor.spec.ts",
    "test:e2e:data": "playwright test e2e/data.spec.ts",
    "test:e2e:seed": "playwright test e2e/seed.spec.ts",
    "test:e2e:print": "playwright test e2e/print.spec.ts",
    "test:e2e:perf": "playwright test e2e/perf.spec.ts",
    "test:e2e:visual": "playwright test e2e/visual.spec.ts",
    "test:e2e:settings-search": "playwright test e2e/settings-search.spec.ts",
    "analyze": "vite build && node scripts/analyze-bundle.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "audit:motion": "node scripts/audit-motion.mjs",
    "audit:a11y": "node scripts/axe-check.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.0",
    "oxc-transform-react": "^0.150.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.17.0"
}
